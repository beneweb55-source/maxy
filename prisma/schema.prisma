generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  gerant
  technicien
  dev
  social_media
}

enum Langue {
  fr
  en
}

enum StatutLot {
  en_cours_de_test
  teste
  valide
}

enum ModeCout {
  manuel
  auto
}

enum StatutProduit {
  recu
  en_test
  ok
  a_reparer
  manque_piece
  hs
  en_vente
  produit_commande
  vendu
  assemble // Composant intégré dans un produit parent (BOM) — retiré du stock général
}

// Types de documents commerciaux légaux
enum TypeDocument {
  FACTURE_TVA  // Facture avec TVA (document fiscal)
  PROFORMA     // Facture proforma (non définitive)
  DEVIS        // Devis client (sans engagement)
}

enum TypeMouvement {
  achat_lot
  vente
  annulation_vente
  apport_associe
  achat_piece
  frais
  retrait_parts
  transfert_reserve
  reinvest
  sortie
}

enum DecisionRapport {
  reparer
  vendre_en_etat
  pieces_detachees
}

enum CarnetCategorie {
  developpement
  inventaire
  caisse
  tests
  maintenance
  ui_ux
  reseau
  materiel
  administration
  recherche
  correction
  autre
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  password_hash  String
  role           Role
  langue         Langue    @default(fr)
  login_attempts Int       @default(0)
  locked_until   DateTime?

  reparations   Reparation[]
  historiques   HistoriqueStatut[]
  mouvements    MouvementCaisse[]
  notifications Notification[]
  push_subscriptions PushSubscription[]
  fcm_tokens    FcmToken[]
  ventes        Vente[]            @relation("ventes_effectuees")
  commandes     Commande[]
  factures      Facture[]
  journal       JournalActivite[]
  carnets       CarnetEntree[]

  @@map("users")
}

model Parametres {
  id                Int      @id @default(1)
  marge_minimum_pct Int      @default(20)
  objectif_reserve  Int      @default(50000)
  pct_reinvest      Int      @default(50)
  pct_reserve       Int      @default(20)
  pct_parts         Int      @default(20)
  pct_frais         Int      @default(10)
  entreprise_nom    String   @default("Solution Maxi")
  entreprise_adresse String  @default("Alger, Algérie")
  entreprise_tel    String   @default("0000 00 00 00")
  entreprise_rc     String   @default("RC XXXXXXXXX")
  entreprise_nif    String   @default("NIF XXXXXXXXX")
  entreprise_nis    String   @default("NIS XXXXXXXXX")
  entreprise_art    String   @default("ART XXXXXXXXX")
  entreprise_rib    String?
  entreprise_cachet String?
  caisse_vide_a     DateTime?
  updated_at        DateTime @updatedAt

  @@map("parametres")
}

model Lot {
  id                  Int       @id @default(autoincrement())
  fournisseur         String
  date_entree         DateTime  @default(now())
  statut_lot          StatutLot @default(en_cours_de_test)
  description         String?
  quantite_attendue   Int?      @default(0)
  cout_global_declare Int?
  mode_cout           ModeCout  @default(manuel)
  cout_valide         Boolean   @default(false)

  produits   Produit[]
  mouvements MouvementCaisse[]

  @@map("lots")
}

model Categorie {
  id          Int         @id @default(autoincrement())
  nom         String
  parent_id   Int?
  image_url   String?
  description String?
  ordre       Int         @default(0)
  attributs_schema Json?  
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  parent      Categorie?  @relation("HierarchieCategorie", fields: [parent_id], references: [id])
  enfants     Categorie[] @relation("HierarchieCategorie")
  modeles     Modele[]
  produits    Produit[]

  @@map("categories")
}

model Modele {
  id           Int      @id @default(autoincrement())
  categorie_id Int
  nom          String   
  image_url    String?
  description  String?
  attributs    Json?     
  prix_vente_conseille Int? 
  quantite     Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  categorie    Categorie @relation(fields: [categorie_id], references: [id])
  exemplaires  Produit[] 
  lignes_commande LigneCommande[]

  @@index([categorie_id])
  @@map("modeles")
}

model CategorieInfo {
  nom         String   @id // The name of the categorie field (e.g. "laptop")
  image_url   String?
  description String?
  updated_at  DateTime @updatedAt

  @@map("categories_info")
}

model FamilleInfo {
  id          String   @id // Clé encodée stable (ex: base64(reference|categorie))
  nom         String?
  image_url   String?
  description String?
  updated_at  DateTime @updatedAt

  @@map("familles_info")
}

model Produit {
  id               Int              @id @default(autoincrement())
  lot_id           Int?
  modele_id        Int?
  categorie_id     Int?
  code_interne     String           @unique
  reference        String
  categorie        String
  numero_serie     String?
  grade            String?
  emplacement      String?          @default("reserve")
  statut           StatutProduit    @default(recu)
  prix_achat       Int
  prix_vente_fixe  Int?
  prix_vente_reel  Int?
  date_vente       DateTime?
  notes            String?
  image_url        String?
  decision_rapport DecisionRapport?
  a_jeter          Boolean          @default(false)
  en_vitrine       Boolean          @default(false)
  etiquette_imprimee Boolean        @default(false)
  etiquette_imprimee_le DateTime?
  created_at       DateTime         @default(now())

  // === Produits Composés (BOM - Bill of Materials) ===
  // Un PC assemblé peut contenir des composants issus du stock
  est_compose  Boolean              @default(false)      // Indique si le produit a vocation à avoir des composants
  parent_id    Int?                 // Si non-null : ce produit est assemblé dans le produit parent
  parent       Produit?             @relation("ComposantParent", fields: [parent_id], references: [id])
  composants   Produit[]            @relation("ComposantParent")

  lot         Lot?               @relation(fields: [lot_id], references: [id])
  modele      Modele?            @relation(fields: [modele_id], references: [id])
  categorie_rel Categorie?       @relation(fields: [categorie_id], references: [id])
  reparations Reparation[]
  historique  HistoriqueStatut[]
  mouvements  MouvementCaisse[]
  ventes      Vente[]
  lignes_commande LigneCommande[]
  images      ProduitImage[]

  @@index([lot_id])
  @@index([modele_id])
  @@index([categorie_id])
  @@index([statut])
  @@index([en_vitrine])
  @@index([numero_serie])
  @@index([categorie])
  @@index([lot_id, reference, categorie])
  @@index([parent_id])
  @@map("produits")
}

model ProduitImage {
  id         Int      @id @default(autoincrement())
  produit_id Int
  data       String
  position   Int      @default(0)
  created_at DateTime @default(now())

  produit Produit @relation(fields: [produit_id], references: [id], onDelete: Cascade)

  @@index([produit_id])
  @@map("produit_images")
}

model Vente {
  id               Int       @id @default(autoincrement())
  produit_id       Int
  vendu_par        Int
  prix_vente_reel  Int
  canal            String?
  date_vente       DateTime  @default(now())
  annulee          Boolean   @default(false)
  motif_annulation String?
  annulee_par      Int?
  annulee_at       DateTime?
  groupe_vente     String?
  type_vente       TypeVente @default(COMPTOIR)

  produit Produit @relation(fields: [produit_id], references: [id])
  vendeur User    @relation("ventes_effectuees", fields: [vendu_par], references: [id])

  @@index([produit_id])
  @@index([date_vente])
  @@index([type_vente])
  @@map("ventes")
}

model Reparation {
  id          Int      @id @default(autoincrement())
  produit_id  Int
  user_id     Int
  cout        Int
  description String
  date        DateTime @default(now())

  produit Produit @relation(fields: [produit_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([produit_id])
  @@map("reparations")
}

model HistoriqueStatut {
  id           Int            @id @default(autoincrement())
  produit_id   Int
  user_id      Int
  statut_avant StatutProduit?
  statut_apres StatutProduit
  note         String?
  created_at   DateTime       @default(now())

  produit Produit @relation(fields: [produit_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([produit_id])
  @@map("historique_statuts")
}

model MouvementCaisse {
  id          Int           @id @default(autoincrement())
  montant     Int
  type        TypeMouvement
  date        DateTime      @default(now())
  produit_id  Int?
  lot_id      Int?
  user_id     Int
  description String?
  solde_apres Int
  caisse      CaisseDestination @default(CAISSE_PHYSIQUE)

  produit Produit? @relation(fields: [produit_id], references: [id])
  lot     Lot?     @relation(fields: [lot_id], references: [id])
  user    User     @relation(fields: [user_id], references: [id])

  @@index([produit_id])
  @@index([lot_id])
  @@index([date])
  @@index([caisse])
  @@map("mouvements_caisse")
}

model Facture {
  id            Int          @id @default(autoincrement())
  numero        String       @unique
  date_emission DateTime     @default(now())
  type_document TypeDocument @default(FACTURE_TVA) // Type légal du document
  client_nom    String?
  client_adresse String?
  client_tel    String?
  client_rc     String?
  client_nif    String?
  client_ai     String?
  client_nis    String?
  total         Int
  garantie_mois Int          @default(6)
  garantie_fin  DateTime
  canal         String?
  groupe_vente  String?
  cree_par      Int
  annulee       Boolean      @default(false)
  mode_paiement String?      @default("especes")
  canal_vente   CanalVente?  @default(COMPTOIR)
  caisse_destination CaisseDestination @default(CAISSE_PHYSIQUE)
  type_vente    TypeVente    @default(COMPTOIR)
  updated_at    DateTime     @default(now()) @updatedAt

  commande_id   Int?
  commande      Commande?      @relation(fields: [commande_id], references: [id], onDelete: SetNull)

  createur User           @relation(fields: [cree_par], references: [id])
  lignes   FactureLigne[]

  @@index([date_emission])
  @@index([type_document])
  @@index([type_vente])
  @@index([commande_id])
  @@index([caisse_destination])
  @@map("factures")
}

// Les libellés sont dénormalisés (copiés au moment de la vente) : une facture
// doit rester lisible et exacte même si le produit est modifié ou supprimé.
model FactureLigne {
  id           Int      @id @default(autoincrement())
  facture_id   Int
  produit_id   Int?
  vente_id     Int?
  code_interne String
  designation  String
  categorie    String?
  prix         Int
  garantie_fin DateTime

  facture Facture @relation(fields: [facture_id], references: [id], onDelete: Cascade)

  @@index([facture_id])
  @@map("facture_lignes")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  message    String
  type       String?
  lu         Boolean  @default(false)
  lien       String?
  groupe     String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, groupe, lu])
  @@map("notifications")
}

model JournalActivite {
  id          Int      @id @default(autoincrement())
  user_id     Int
  action      String
  entite_type String?
  entite_id   Int?
  details     String?
  ip          String?
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([entite_type, entite_id])
  @@map("journal_activite")
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  user_id    Int
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscriptions")
}

model FcmToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique
  device     String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("fcm_tokens")
}

model CarnetEntree {
  id           Int              @id @default(autoincrement())
  user_id      Int
  titre        String
  categories   CarnetCategorie[]
  contenu      String
  date_travail DateTime
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  user           User                 @relation(fields: [user_id], references: [id])
  pieces_jointes CarnetPieceJointe[]

  @@map("carnet_entrees")
}

model CarnetPieceJointe {
  id           Int      @id @default(autoincrement())
  entree_id    Int
  nom          String
  url          String
  taille       Int
  type         String
  created_at   DateTime @default(now())

  entree       CarnetEntree @relation(fields: [entree_id], references: [id], onDelete: Cascade)

  @@map("carnet_pieces_jointes")
}

enum StatutProposition {
  en_attente
  conflit
  valide
  rejete
}

model PropositionMigration {
  id                String   @id // Hash unique du groupe legacy
  groupe_categorie  String   // Valeur legacy
  groupe_reference  String   // Valeur legacy
  
  // Propositions
  cible_categorie_id Int?    
  cible_modele_nom   String?
  cible_attributs    Json?
  
  // Métriques & Workflow
  statut            StatutProposition @default(en_attente)
  confiance         Int               // 0 à 100
  raisons_json      Json?             // Explicabilité (pourquoi ce choix)
  
  nb_produits       Int      @default(0)
  
  @@map("propositions_migration")
}

model MigrationLog {
  id                Int      @id @default(autoincrement())
  batch_id          String
  produit_id        Int
  modele_id_avant   Int?
  modele_id_apres   Int?
  date              DateTime @default(now())

  @@index([batch_id])
  @@index([produit_id])
  @@map("migration_logs")
}

enum TypeVente {
  COMPTOIR
  YALIDINE
}

enum CanalVente {
  COMPTOIR
  YALIDINE
  OUEDKNISS
  TELEPHONE
  FACEBOOK
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  EN_LIVRAISON
  TERMINEE
  ANNULEE
}

enum CaisseDestination {
  CAISSE_PHYSIQUE
  CAISSE_YALIDINE
}

enum TypePaiement {
  especes
  virement
  carte
  cheque
}

model Client {
  id                  Int        @id @default(autoincrement())
  nom                 String
  telephone           String?
  email               String?
  adresse             String?
  registre_commerce   String?
  nif                 String?
  nis                 String?
  article_imposition  String?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  commandes           Commande[]

  @@map("clients")
}

model Commande {
  id               Int            @id @default(autoincrement())
  numero           String         @unique
  date_commande    DateTime       @default(now())
  canal            CanalVente     @default(COMPTOIR)
  statut           StatutCommande @default(EN_ATTENTE)
  caisse           CaisseDestination @default(CAISSE_PHYSIQUE)
  type_paiement    TypePaiement   @default(especes)
  payee            Boolean        @default(false)
  
  client_id        Int?
  client           Client?        @relation(fields: [client_id], references: [id], onDelete: SetNull)
  
  client_nom       String?
  client_tel       String?
  client_adresse   String?
  wilaya           String?
  commune          String?
  frais_livraison  Int            @default(0)

  total_ht         Int
  total_tva        Int            @default(0)
  total_ttc        Int
  remise_globale   Int            @default(0)
  
  garantie_mois    Int            @default(6)
  garantie_fin     DateTime
  
  notes            String?
  cree_par         Int
  vendeur          User           @relation(fields: [cree_par], references: [id])
  
  lignes           LigneCommande[]
  factures         Facture[]
  
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([date_commande])
  @@index([statut])
  @@index([canal])
  @@index([caisse])
  @@index([client_id])
  @@map("commandes")
}

model LigneCommande {
  id              Int       @id @default(autoincrement())
  commande_id     Int
  commande        Commande  @relation(fields: [commande_id], references: [id], onDelete: Cascade)
  
  produit_id      Int?
  produit         Produit?  @relation(fields: [produit_id], references: [id], onDelete: SetNull)
  
  modele_id       Int?
  modele          Modele?   @relation(fields: [modele_id], references: [id], onDelete: SetNull)

  code_interne    String
  designation     String
  numero_serie    String?
  categorie       String?
  
  quantite        Int       @default(1)
  prix_unitaire   Int
  remise_ligne    Int       @default(0)
  total_ligne     Int
  mode_ajout      String?   @default("scan") // "scan" | "manuel"
  etiquette_imprimee Boolean @default(false)

  @@index([commande_id])
  @@index([produit_id])
  @@map("lignes_commande")
}

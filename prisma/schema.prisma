generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  gerant
  technicien
  dev
  social_media
}

enum Langue {
  fr
  en
}

enum StatutLot {
  en_cours_de_test
  teste
  valide
}

enum ModeCout {
  manuel
  auto
}

enum StatutProduit {
  recu
  en_test
  ok
  a_reparer
  manque_piece
  hs
  en_vente
  vendu
}

enum TypeMouvement {
  achat_lot
  vente
  annulation_vente
  apport_associe
  achat_piece
  frais
  retrait_parts
  transfert_reserve
  reinvest
}

enum DecisionRapport {
  reparer
  vendre_en_etat
  pieces_detachees
}

enum CarnetCategorie {
  developpement
  inventaire
  caisse
  tests
  maintenance
  ui_ux
  reseau
  materiel
  administration
  recherche
  correction
  autre
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  password_hash  String
  role           Role
  langue         Langue    @default(fr)
  login_attempts Int       @default(0)
  locked_until   DateTime?

  reparations   Reparation[]
  historiques   HistoriqueStatut[]
  mouvements    MouvementCaisse[]
  notifications Notification[]
  push_subscriptions PushSubscription[]
  fcm_tokens    FcmToken[]
  ventes        Vente[]            @relation("ventes_effectuees")
  factures      Facture[]
  journal       JournalActivite[]
  carnets       CarnetEntree[]

  @@map("users")
}

model Parametres {
  id                Int      @id @default(1)
  marge_minimum_pct Int      @default(20)
  objectif_reserve  Int      @default(50000)
  pct_reinvest      Int      @default(50)
  pct_reserve       Int      @default(20)
  pct_parts         Int      @default(20)
  pct_frais         Int      @default(10)
  entreprise_nom    String   @default("Solution Maxi")
  entreprise_adresse String  @default("Alger, Algérie")
  entreprise_tel    String   @default("0000 00 00 00")
  entreprise_rc     String   @default("RC XXXXXXXXX")
  entreprise_nif    String   @default("NIF XXXXXXXXX")
  entreprise_nis    String   @default("NIS XXXXXXXXX")
  entreprise_art    String   @default("ART XXXXXXXXX")
  entreprise_rib    String?
  entreprise_cachet String?
  caisse_vide_a     DateTime?
  updated_at        DateTime @updatedAt

  @@map("parametres")
}

model Lot {
  id                  Int       @id @default(autoincrement())
  fournisseur         String
  date_entree         DateTime  @default(now())
  statut_lot          StatutLot @default(en_cours_de_test)
  description         String?
  quantite_attendue   Int?      @default(0)
  cout_global_declare Int?
  mode_cout           ModeCout  @default(manuel)
  cout_valide         Boolean   @default(false)

  produits   Produit[]
  mouvements MouvementCaisse[]

  @@map("lots")
}

model Categorie {
  id          Int         @id @default(autoincrement())
  nom         String
  parent_id   Int?
  image_url   String?
  description String?
  ordre       Int         @default(0)
  attributs_schema Json?  
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  parent      Categorie?  @relation("HierarchieCategorie", fields: [parent_id], references: [id])
  enfants     Categorie[] @relation("HierarchieCategorie")
  modeles     Modele[]

  @@map("categories")
}

model Modele {
  id           Int      @id @default(autoincrement())
  categorie_id Int
  nom          String   
  image_url    String?
  description  String?
  attributs    Json?     
  prix_vente_conseille Int? 
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  categorie    Categorie @relation(fields: [categorie_id], references: [id])
  exemplaires  Produit[] 

  @@index([categorie_id])
  @@map("modeles")
}

model CategorieInfo {
  nom         String   @id // The name of the categorie field (e.g. "laptop")
  image_url   String?
  description String?
  updated_at  DateTime @updatedAt

  @@map("categories_info")
}

model FamilleInfo {
  id          String   @id // Clé encodée stable (ex: base64(reference|categorie))
  nom         String?
  image_url   String?
  description String?
  updated_at  DateTime @updatedAt

  @@map("familles_info")
}

model Produit {
  id               Int              @id @default(autoincrement())
  lot_id           Int?
  modele_id        Int?
  code_interne     String           @unique
  reference        String
  categorie        String
  statut           StatutProduit    @default(recu)
  prix_achat       Int
  prix_vente_fixe  Int?
  prix_vente_reel  Int?
  date_vente       DateTime?
  notes            String?
  image_url        String?
  decision_rapport DecisionRapport?
  a_jeter          Boolean          @default(false)
  en_vitrine       Boolean          @default(false)
  etiquette_imprimee Boolean        @default(false)
  etiquette_imprimee_le DateTime?
  created_at       DateTime         @default(now())

  lot         Lot?               @relation(fields: [lot_id], references: [id])
  modele      Modele?            @relation(fields: [modele_id], references: [id])
  reparations Reparation[]
  historique  HistoriqueStatut[]
  mouvements  MouvementCaisse[]
  ventes      Vente[]
  images      ProduitImage[]

  @@index([lot_id])
  @@index([modele_id])
  @@index([statut])
  @@index([categorie])
  @@index([lot_id, reference, categorie])
  @@map("produits")
}

model ProduitImage {
  id         Int      @id @default(autoincrement())
  produit_id Int
  data       String
  position   Int      @default(0)
  created_at DateTime @default(now())

  produit Produit @relation(fields: [produit_id], references: [id], onDelete: Cascade)

  @@index([produit_id])
  @@map("produit_images")
}

model Vente {
  id               Int       @id @default(autoincrement())
  produit_id       Int
  vendu_par        Int
  prix_vente_reel  Int
  canal            String?
  date_vente       DateTime  @default(now())
  annulee          Boolean   @default(false)
  motif_annulation String?
  annulee_par      Int?
  annulee_at       DateTime?
  groupe_vente     String?

  produit Produit @relation(fields: [produit_id], references: [id])
  vendeur User    @relation("ventes_effectuees", fields: [vendu_par], references: [id])

  @@index([produit_id])
  @@index([date_vente])
  @@map("ventes")
}

model Reparation {
  id          Int      @id @default(autoincrement())
  produit_id  Int
  user_id     Int
  cout        Int
  description String
  date        DateTime @default(now())

  produit Produit @relation(fields: [produit_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([produit_id])
  @@map("reparations")
}

model HistoriqueStatut {
  id           Int            @id @default(autoincrement())
  produit_id   Int
  user_id      Int
  statut_avant StatutProduit?
  statut_apres StatutProduit
  note         String?
  created_at   DateTime       @default(now())

  produit Produit @relation(fields: [produit_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([produit_id])
  @@map("historique_statuts")
}

model MouvementCaisse {
  id          Int           @id @default(autoincrement())
  montant     Int
  type        TypeMouvement
  date        DateTime      @default(now())
  produit_id  Int?
  lot_id      Int?
  user_id     Int
  description String?
  solde_apres Int

  produit Produit? @relation(fields: [produit_id], references: [id])
  lot     Lot?     @relation(fields: [lot_id], references: [id])
  user    User     @relation(fields: [user_id], references: [id])

  @@index([produit_id])
  @@index([lot_id])
  @@index([date])
  @@map("mouvements_caisse")
}

model Facture {
  id            Int      @id @default(autoincrement())
  numero        String   @unique
  date_emission DateTime @default(now())
  type_facture  String   @default("normale") // "normale", "tva", "proforma"
  client_nom    String?
  client_adresse String?
  client_tel    String?
  client_rc     String?
  client_nif    String?
  client_ai     String?
  client_nis    String?
  total         Int
  garantie_mois Int      @default(6)
  garantie_fin  DateTime
  canal         String?
  groupe_vente  String?
  cree_par      Int
  annulee       Boolean  @default(false)
  mode_paiement String?  @default("especes")
  updated_at    DateTime @default(now()) @updatedAt

  createur User           @relation(fields: [cree_par], references: [id])
  lignes   FactureLigne[]

  @@index([date_emission])
  @@map("factures")
}

// Les libellés sont dénormalisés (copiés au moment de la vente) : une facture
// doit rester lisible et exacte même si le produit est modifié ou supprimé.
model FactureLigne {
  id           Int      @id @default(autoincrement())
  facture_id   Int
  produit_id   Int?
  vente_id     Int?
  code_interne String
  designation  String
  categorie    String?
  prix         Int
  garantie_fin DateTime

  facture Facture @relation(fields: [facture_id], references: [id], onDelete: Cascade)

  @@index([facture_id])
  @@map("facture_lignes")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  message    String
  type       String?
  lu         Boolean  @default(false)
  lien       String?
  groupe     String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, groupe, lu])
  @@map("notifications")
}

model JournalActivite {
  id          Int      @id @default(autoincrement())
  user_id     Int
  action      String
  entite_type String?
  entite_id   Int?
  details     String?
  ip          String?
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([entite_type, entite_id])
  @@map("journal_activite")
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  user_id    Int
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscriptions")
}

model FcmToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique
  device     String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("fcm_tokens")
}

model CarnetEntree {
  id           Int              @id @default(autoincrement())
  user_id      Int
  titre        String
  categories   CarnetCategorie[]
  contenu      String
  date_travail DateTime
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  user           User                 @relation(fields: [user_id], references: [id])
  pieces_jointes CarnetPieceJointe[]

  @@map("carnet_entrees")
}

model CarnetPieceJointe {
  id           Int      @id @default(autoincrement())
  entree_id    Int
  nom          String
  url          String
  taille       Int
  type         String
  created_at   DateTime @default(now())

  entree       CarnetEntree @relation(fields: [entree_id], references: [id], onDelete: Cascade)

  @@map("carnet_pieces_jointes")
}

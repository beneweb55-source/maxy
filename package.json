{
  "name": "gestion-maxi",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:safe": "set NEXT_DIST_DIR=C:\\maxy-build && next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "build:safe": "set NEXT_DIST_DIR=C:\\maxy-build && next build",
    "start": "next start",
    "start:safe": "set NEXT_DIST_DIR=C:\\maxy-build && next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win",
    "migrate:inventory": "tsx scripts/auto_migrate_inventory.ts",
    "fix:strings": "tsx scripts/fix_legacy_strings.ts"
  },
  "build": {
    "appId": "com.gestionmaxi.desktop",
    "productName": "Gestion Maxi",
    "directories": {
      "output": "out"
    },
    "win": {
      "target": "nsis"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@prisma/client": "^6.11.0",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/papaparse": "^5.5.2",
    "@vercel/blob": "^2.6.1",
    "firebase-admin": "^14.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.37.0",
    "next": "^15.3.4",
    "papaparse": "^5.7.0",
    "pathe": "^2.0.3",
    "react": "^19.1.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "written-number": "^0.11.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "playwright": "^1.62.1",
    "prisma": "^6.11.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
